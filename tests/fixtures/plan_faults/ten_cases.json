{
  "_comment": "Hand-built classify() fixture (design memo section 6): every one of the four Outcome classes appears at least once, with I1-I4 each demonstrated at least once and one case demonstrating gold_mismatch orthogonal to a `correct` outcome. No store, no LLM, no trace object -- these are plain dicts fed straight to tgms.eval.plan_faults.Run/Oracle/classify.",
  "cases": [
    {
      "id": "correct-plain",
      "description": "A TGIR-envelope-shaped run: no claims, FRESH and recomputation agrees. No gold supplied.",
      "run": {
        "certificate": null,
        "freshness": {"kind": "FRESH"},
        "answer": {"claims": []},
        "answer_value": 42,
        "report": {"claims": []},
        "error": null
      },
      "oracle": {"recompute_value": 42},
      "expected_outcome": "correct",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": []
    },
    {
      "id": "correct-but-gold-mismatch",
      "description": "An agent-answer run whose single count claim is fully supported by its own trace (evidence-consistent) but disagrees with gold -- the F1-3b/F1-6 reading: correct under I1-I4, gold_mismatch fires anyway. Asserts the orthogonality of the two flags.",
      "run": {
        "certificate": null,
        "freshness": null,
        "answer": {"claims": [
          {"id": "c1", "type": "count", "value": 7, "evidence": ["s1"]}
        ]},
        "answer_value": 7,
        "report": {"claims": [
          {"id": "c1", "verdict": "supported", "reason": "matched 7",
           "truncated": false, "cited_uids": [], "cited_values": [7]}
        ]},
        "error": null
      },
      "oracle": {"gold": 9},
      "expected_outcome": "correct",
      "expected_gold_mismatch": true,
      "expected_misattributed": false,
      "expected_invariants": []
    },
    {
      "id": "safe-refusal-cost-certificate",
      "description": "A plan-level RefusalCertificate (admission.py stage=plan) -- the refusal channel fires before anything else is inspected.",
      "run": {
        "certificate": {"reason": "cost-ceiling:plan", "detail": {"stage": "plan"}},
        "freshness": null,
        "answer": null,
        "answer_value": null,
        "report": null,
        "error": null
      },
      "oracle": {},
      "expected_outcome": "safe-refusal",
      "expected_reason": "cost-ceiling:plan",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": []
    },
    {
