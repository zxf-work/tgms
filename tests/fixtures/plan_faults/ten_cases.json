        "freshness": null,
        "answer": null,
        "answer_value": null,
        "report": null,
        "error": null
      },
      "oracle": {},
      "expected_outcome": "safe-refusal",
      "expected_reason": "incompleteness",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": []
    },
    {
      "id": "safe-refusal-undecidable-freshness",
