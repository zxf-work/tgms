    {
      "id": "silent-violation-unsupported-count",
      "description": "A count claim whose value (5) is not among the cited evidence's numbers (only 3 is present) -- I1 (verdict unsupported) and I3 (value not grounded) fire together, exactly F1-7/F1-10's shape.",
      "run": {
        "certificate": null,
        "freshness": null,
        "answer": {"claims": [
          {"id": "c1", "type": "count", "value": 5, "evidence": ["s1"]}
        ]},
        "answer_value": 5,
        "report": {"claims": [
          {"id": "c1", "verdict": "unsupported", "reason": "value 5 not found in evidence (candidates: [3])",
           "truncated": false, "cited_uids": [], "cited_values": [3]}
        ]},
        "error": null
      },
      "oracle": {},
      "expected_outcome": "silent-violation",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": ["I1", "I3"]
    },
    {
      "id": "silent-violation-uid-not-grounded",
      "description": "The verifier's own entity check missed it (verdict still `supported`) but the claimed uid does not actually appear in the cited evidence's lexicon -- I2, a defense-in-depth check independent of the verdict.",
      "run": {
        "certificate": null,
        "freshness": null,
        "answer": {"claims": [
          {"id": "c1", "type": "entity", "uids": ["n999"], "evidence": ["s1"]}
        ]},
        "answer_value": ["n999"],
        "report": {"claims": [
          {"id": "c1", "verdict": "supported", "reason": "all uids grounded",
           "truncated": false, "cited_uids": ["n1", "n2"], "cited_values": []}
        ]},
        "error": null
      },
      "oracle": {},
      "expected_outcome": "silent-violation",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": ["I2"]
    },
    {
      "id": "silent-violation-fresh-contradicted",
      "description": "check() said FRESH but an independent recomputation disagrees with the answer value -- I4, check.py:415,561's exact failure mode.",
      "run": {
        "certificate": null,
        "freshness": {"kind": "FRESH"},
        "answer": {"claims": []},
        "answer_value": 100,
        "report": {"claims": []},
        "error": null
      },
      "oracle": {"recompute_value": 99},
      "expected_outcome": "silent-violation",
      "expected_gold_mismatch": null,
      "expected_misattributed": false,
      "expected_invariants": ["I4"]
    }
  ]
