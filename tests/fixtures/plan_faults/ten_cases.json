      "expected_invariants": []
    },
    {
      "id": "explicit-failure-static-schema",
      "description": "validate_static rejected the mutated plan (E_SCHEMA) and no repair was attempted -- no trace, no certificate.",
      "run": {
        "certificate": null,
        "freshness": null,
        "answer": null,
        "answer_value": null,
